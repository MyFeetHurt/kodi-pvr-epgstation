# Build image for portable Linux builds of pvr.epgstation: Debian 12 "bookworm" (glibc 2.36,
# GCC 12) so the add-on loads on any Linux with Kodi 21 from 2023 on, not only on the newest
# distros. Native x86_64 and cross aarch64 compilers (Windows: Containerfile.windows); Kodi's add-on headers and CMake files are
# mounted from the dev VM (they are the same on every architecture).
FROM docker.io/library/debian:12
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      cmake ninja-build g++ make ca-certificates nlohmann-json3-dev \
      g++-aarch64-linux-gnu binutils-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*
