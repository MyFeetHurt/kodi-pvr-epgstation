# Kodi Media Center language file
# Addon id: pvr.epgstation
msgid ""
msgstr ""
"Language: ja_JP\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "#30000"
msgid "Connection"
msgstr "接続"

msgctxt "#30001"
msgid "EPGStation URL"
msgstr "EPGStation の URL"

msgctxt "#30002"
msgid "Address of the EPGStation server, e.g. http://192.168.0.10:8888"
msgstr "EPGStation サーバーのアドレス（例: http://192.168.0.10:8888）"

msgctxt "#30010"
msgid "Live TV"
msgstr "ライブ視聴"

msgctxt "#30011"
msgid "Stream mode"
msgstr "配信モード"

msgctxt "#30012"
msgid "Name of an EPGStation live m2ts mode, e.g. 720p. Leave empty for the original broadcast (無変換)."
msgstr "EPGStation のライブ m2ts モード名（例: 720p）。空欄なら無変換で視聴します。"

msgctxt "#30013"
msgid "Live TV is disabled in EPGStation"
msgstr "EPGStation でライブ視聴が無効になっています"

msgctxt "#30014"
msgid "Stream mode \"%s\" not found. EPGStation has: %s"
msgstr "配信モード「%s」がありません。EPGStation のモード: %s"

msgctxt "#30020"
msgid "Recordings"
msgstr "録画"

msgctxt "#30021"
msgid "Play the encoded file when there is one"
msgstr "エンコード済みファイルがあればそれを再生する"

msgctxt "#30022"
msgid "EPGStation can encode recordings (e.g. to H.264) and keep the original TS. On: play the newest encoded file; off: always the TS."
msgstr "EPGStation は録画をエンコード（H.264 など）して元の TS も残せます。オン: 最新のエンコード済みファイルを再生、オフ: 常に TS を再生。"

msgctxt "#30023"
msgid "This recording is protected in EPGStation and was not deleted"
msgstr "この録画は EPGStation で保護されているため削除しませんでした"

msgctxt "#30030"
msgid "One time (guide)"
msgstr "単発予約（番組表）"

msgctxt "#30031"
msgid "One time (manual)"
msgstr "単発予約（時刻指定）"

msgctxt "#30032"
msgid "From an EPGStation rule"
msgstr "EPGStation のルール予約"

msgctxt "#30033"
msgid "EPGStation cannot change this reservation. Delete it and record again."
msgstr "EPGStation では予約を変更できません。削除してから予約し直してください。"

msgctxt "#30034"
msgid "Reservation failed: %s"
msgstr "予約できませんでした: %s"

msgctxt "#30035"
msgid "Rule (keyword)"
msgstr "ルール（キーワード）"

msgctxt "#30036"
msgid "Rule (series from the guide)"
msgstr "ルール（番組表からシリーズ）"

msgctxt "#30037"
msgid "Record all"
msgstr "すべて録画"

msgctxt "#30038"
msgid "Skip programmes already recorded"
msgstr "録画済みの番組は録画しない"

msgctxt "#30039"
msgid "EPGStation rule (edit in EPGStation)"
msgstr "EPGStation のルール（EPGStation で編集）"

msgctxt "#30040"
msgid "Enter what to search the guide for"
msgstr "番組表で検索する文字を入力してください"
